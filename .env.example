# Defaults run offline: no API keys, network model calls or trace exports.
INCIDENTOPS_PROVIDER=fake
INCIDENTOPS_DATABASE_URL=sqlite:///.local/incidentops.db
INCIDENTOPS_CORPUS_DIR=data/corpus
INCIDENTOPS_ACME_TOKEN=acme-demo-token
INCIDENTOPS_BRAVO_TOKEN=bravo-demo-token
# Change both tokens before exposing anything beyond your local computer.

# Optional live path. A ChatGPT subscription is not an API credential.
# INCIDENTOPS_PROVIDER=openai
# INCIDENTOPS_DATABASE_URL=postgresql://incidentops:incidentops@localhost:5432/incidentops
# OPENAI_API_KEY=
# INCIDENTOPS_CHAT_MODEL=gpt-4.1-mini
# INCIDENTOPS_EMBEDDING_MODEL=text-embedding-3-small
# INCIDENTOPS_EMBEDDING_DIMENSIONS=1536

# Optional application-owned, metadata-only LangSmith traces.
INCIDENTOPS_TRACING=false
# LANGSMITH_API_KEY=
INCIDENTOPS_TRACE_PROJECT=incidentops-increment-1

INCIDENTOPS_TOP_K=5
INCIDENTOPS_CONTEXT_TOKENS=1800
INCIDENTOPS_CHUNK_SIZE_CHARS=350
INCIDENTOPS_CHUNK_OVERLAP_CHARS=40
INCIDENTOPS_EMBEDDING_BATCH_SIZE=32
INCIDENTOPS_INGESTION_MAX_CHUNKS=2000
INCIDENTOPS_TIMEOUT_SECONDS=20
INCIDENTOPS_MAX_RETRIES=1

# v2: persisted jobs, async workers and interchangeable vector stores.
INCIDENTOPS_WORKFLOW_DATABASE_URL=sqlite+aiosqlite:///.local/workflows.db
INCIDENTOPS_VECTOR_BACKEND=local
INCIDENTOPS_OBJECT_BACKEND=local
INCIDENTOPS_OBJECT_ROOT=.local/objects
# PostgreSQL deployment examples (run workflow migrate and index-init explicitly):
# INCIDENTOPS_WORKFLOW_DATABASE_URL=postgresql+asyncpg://incidentops:incidentops@localhost:5432/incidentops
# INCIDENTOPS_VECTOR_BACKEND=pgvector
# INCIDENTOPS_VECTOR_DATABASE_URL=postgresql://incidentops:incidentops@localhost:5432/incidentops
INCIDENTOPS_HNSW=false
INCIDENTOPS_HNSW_EF_SEARCH=100
INCIDENTOPS_VECTOR_EXACT=false
# Pinecone alternative: existing index host, correct dimensions, cosine metric.
# INCIDENTOPS_VECTOR_BACKEND=pinecone
# INCIDENTOPS_PINECONE_HOST=https://your-index-host
# PINECONE_API_KEY=
# Real S3 requires a versioning-enabled bucket and normal boto3 IAM configuration.
# INCIDENTOPS_OBJECT_BACKEND=s3
# INCIDENTOPS_S3_BUCKET=your-private-versioned-bucket
INCIDENTOPS_BROKER_URL=amqp://guest:guest@127.0.0.1:5672//
INCIDENTOPS_DENSE_K=40
INCIDENTOPS_LEXICAL_K=40
INCIDENTOPS_RERANK_K=20
INCIDENTOPS_FINAL_K=5
INCIDENTOPS_RRF_CONSTANT=60
INCIDENTOPS_RETRIEVAL_MAX_CHUNKS=2000
INCIDENTOPS_LEASE_SECONDS=60
INCIDENTOPS_JOB_DEADLINE_SECONDS=300
INCIDENTOPS_WORKER_MAX_ATTEMPTS=3
INCIDENTOPS_PROVIDER_CONCURRENCY=4
INCIDENTOPS_MAX_INPUT_TOKEN_BOUND=8000
INCIDENTOPS_MAX_REQUEST_BYTES=512000
INCIDENTOPS_HTTP_CONCURRENCY=64
